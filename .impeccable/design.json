  "narrative": {
    "overview": "This captures the implemented **Studio workspace only**. It does not prescribe the public portfolio, sign-in, or onboarding identity. The existing NOL identity supplies dark ink, warm gray, Archivo Black and a red action accent; readable Arial carries the operational interface.\n\nThe workspace keeps the next task visible: add files, follow preparation, review a preview and explicitly approve publication. It uses a restrained, mostly flat interface with strong headings and plain instructions. This is an extraction of the built system, not a new visual identity proposal.",
    "keyCharacteristics": [
      "Archivo Black for NOL and major headings; Arial for routine reading and actions.",
      "Warm gray text, quiet dividers and red primary actions.",
      "Persistent navigation and visible upload choices.",
      "Plain-language status and explicit approval controls."
    ],
    "rules": [
      {
        "name": "The Action Rule",
        "body": "Preserve red for purposeful controls and state emphasis; use text alongside color to explain status.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** preserve the NOL identity while using readable workspace body text.",
      "**Do** keep visible file/folder actions, navigation and a reachable review action.",
      "**Do** pair worker/drop state with truthful words and a relevant next action.",
      "**Do** preserve preview review, revision and explicit publish confirmation.",
      "**Do** describe drafts as saved on this device and origin, with storage-failure feedback."
    ],
    "donts": [
      "**Don't** apply this workspace extraction as a redesign of the public portfolio.",
      "**Don't** imply that sending, retrying or requesting changes publishes work.",
      "**Don't** present local drafts or local recent answers as cross-device synchronization.",
      "**Don't** replace live connection/worker state with an always-ready decorative indicator.",
      "**Don't** treat fixture screenshots as evidence of a production upload or publication."
    ]
  },
  "notes": [
    "Color ramps are synthesized preview extensions, not implemented CSS scales.",
    "No new creative north star was invented; the incumbent NOL identity remains authoritative.",
    "Component snippets resolve scoped workspace tokens to literals so shadow-DOM previews render independently."
  ]
}
